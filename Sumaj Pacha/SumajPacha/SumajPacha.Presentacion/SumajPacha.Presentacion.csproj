<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>SumajPacha.Presentacion</RootNamespace>
    <AssemblyName>SumajPacha</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.ComponentModel" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Formularios\FrmLogin.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Formularios\FrmPrincipal.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Formularios\FrmFamilias.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Formularios\FrmEntregas.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Formularios\FrmVisitas.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Formularios\FrmReportes.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Formularios\FrmAdministracion.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>
