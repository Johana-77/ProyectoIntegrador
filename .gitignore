## .gitignore para proyectos C# / .NET / Visual Studio

# Carpetas de compilación
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# Visual Studio Code / Rider
.vscode/
.idea/

# Paquetes NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets
project.assets.json

# Resultados de pruebas
[Tt]est[Rr]esult*/
*.trx
*.coverage

# Archivos temporales
*.tmp
*.log
*.cache
*.pdb

# Bases de datos locales
*.mdf
*.ldf
*.db
*.sqlite

# Configuración con contraseñas (usar un archivo de ejemplo en su lugar)
appsettings.Development.json
secrets.json

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store
